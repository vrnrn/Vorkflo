{
  "name": "@vorkflo/markdown-context-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "vorkflo-markdown-context-runner": "./dist/src/cli.js",
    "vorkflo-markdown-image-report": "./dist/src/image-report-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write package.json tsconfig.json src test",
    "format:check": "prettier --check package.json tsconfig.json src test",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT"
}
